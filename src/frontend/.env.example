# Microsoft Entra ID (Azure AD) app registration used by the InsureWell SPA.
# Leave empty to run locally without authentication.
REACT_APP_AZURE_TENANT_ID=
REACT_APP_AZURE_CLIENT_ID=

# Optional overrides
# REACT_APP_AZURE_CLOUD_INSTANCE=https://login.microsoftonline.com
# REACT_APP_AZURE_REDIRECT_URI=http://localhost:3000
# REACT_APP_AZURE_API_SCOPE=api://<backend-client-id>/access_as_user
# REACT_APP_API_BASE_URL=http://localhost:8080/api
